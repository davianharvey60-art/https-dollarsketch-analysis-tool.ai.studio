    const DERIV_WS_URL = 'wss://api.derivws.com/trading/v1/options/ws/public';

    // ================== DEBUG PANEL ==================
    const dbgLines = ['', '', '', ''];
    function dbg(msg, type) {
      const time = new Date().toLocaleTimeString();
      const icon = type === 'err' ? '❌' : type === 'warn' ? '⚠️' : '✅';
      dbgLines.unshift(icon + ' ' + time + ' ' + msg);
      if (dbgLines.length > 4) dbgLines.pop();
      for (let i = 0; i < 4; i++) {
        const el = document.getElementById('dbg' + (i + 1));
        if (el) {
          el.textContent = dbgLines[i] || '—';
          el.className = 'line';
          if (dbgLines[i] && dbgLines[i].indexOf('❌') === 0) el.classList.add('err');
          else if (dbgLines[i] && dbgLines[i].indexOf('⚠️') === 0) el.classList.add('warn');
          else if (dbgLines[i]) el.classList.add('ok');
        }
      }
      if (type === 'err') console.error(msg);
      else if (type === 'warn') console.warn(msg);
      else console.log(msg);
    }

    // ================== GLOBAL STATE ==================
    const state = {
      ws: null,
      wsConnected: false,
      wsConnecting: false,
      subscribedSymbols: new Set(),
      reconnectAttempts: 0,
      reconnectTimer: null,
      keepAliveTimer: null,
      classicDigits: [],
      deepseekDigits: [],
      deepseekSymbol: 'R_75',
      deepseekPrediction: 5,
      deepseekConfidence: 65,
      deepseekTickCount: 0,
      lastDigitBySymbol: {},
      classicChart: null,
      deepseekChart: null,
      isAnalyzing: false,
      termsAccepted: false,
      currentUser: null,
      _tickStreamHistory: [],
      tickCounter: 0,
      reqIdCounter: 1
    };

    const CLASSIC_SYMBOL = 'R_100';
    const CLASSIC_MAX = 20;
    const DEEPSEEK_MAX = 25;

    const volatilityMarkets = [
      { symbol: "R_10", name: "Vol 10" },
      { symbol: "R_25", name: "Vol 25" },
      { symbol: "R_50", name: "Vol 50" },
      { symbol: "R_75", name: "Vol 75" },
      { symbol: "R_100", name: "Vol 100" },
      { symbol: "1HZ10V", name: "V10 1s" },
      { symbol: "1HZ25V", name: "V25 1s" },
      { symbol: "1HZ50V", name: "V50 1s" },
      { symbol: "1HZ75V", name: "V75 1s" },
      { symbol: "1HZ100V", name: "V100 1s" }
    ];

    // ================== CONNECTION STATUS UI ==================
    function setConnStatus(status) {
      const els = [
        document.getElementById('globalConnStatus'),
        document.getElementById('classicConnStatus'),
        document.getElementById('deepseekConnStatus')
      ];
      els.forEach(function (el) {
        if (!el) return;
        el.className = 'conn-status ' + status;
        const txt = status === 'connected' ? 'Live' : (status === 'connecting' ? 'Connecting...' : 'Offline');
        el.innerHTML = '<span class="conn-dot"></span> ' + txt;
      });
    }

    // ================== WEBSOCKET ==================
    function connectDeriv() {
      if (state.wsConnected || state.wsConnecting) return;
      state.wsConnecting = true;
      setConnStatus('connecting');
      dbg('Opening WebSocket...', 'ok');

      try {
        state.ws = new WebSocket(DERIV_WS_URL);
      } catch (e) {
        state.wsConnecting = false;
        setConnStatus('disconnected');
        dbg('Failed to create WS: ' + e.message, 'err');
        scheduleReconnect();
        return;
      }

      state.ws.onopen = function () {
        state.wsConnected = true;
        state.wsConnecting = false;
        state.reconnectAttempts = 0;
        setConnStatus('connected');
        dbg('WS Connected ✓', 'ok');
        startKeepAlive();

        const syms = Array.from(state.subscribedSymbols);
        if (syms.length === 0) {
          dbg('No symbols queued yet', 'warn');
        } else {
          syms.forEach(function (sym) {
            const msg = JSON.stringify({ ticks: sym, subscribe: 1, req_id: state.reqIdCounter++ });
            try {
              state.ws.send(msg);
              dbg('Sub sent: ' + sym, 'ok');
            } catch (e) {
              dbg('Sub failed: ' + sym, 'err');
            }
          });
        }
      };

      state.ws.onmessage = function (event) {
        let data;
        try { data = JSON.parse(event.data); } catch (e) { return; }

        if (data.msg_type === 'tick' && data.tick) {
          state.tickCounter++;
          if (state.tickCounter <= 3) {
            dbg('TICK #' + state.tickCounter + ' ' + (data.tick.symbol || data.tick.underlying_symbol) + ' ' + data.tick.quote, 'ok');
          }
          handleTick(data.tick);
        } else if (data.error) {
          dbg('Deriv err: ' + (data.error.message || JSON.stringify(data.error)), 'err');
        } else if (data.msg_type && state.tickCounter === 0) {
          dbg('Msg: ' + data.msg_type, 'warn');
        }
      };

      state.ws.onerror = function (err) {
        state.wsConnecting = false;
        dbg('WS Error — check network/firewall', 'err');
      };

      state.ws.onclose = function (event) {
        state.wsConnected = false;
        state.wsConnecting = false;
        stopKeepAlive();
        setConnStatus('disconnected');
        dbg('WS Closed code=' + event.code, 'warn');
        scheduleReconnect();
      };
    }

    function scheduleReconnect() {
      if (state.reconnectTimer) clearTimeout(state.reconnectTimer);
      state.reconnectAttempts++;
      const delay = Math.min(10000, 1500 * state.reconnectAttempts);
      dbg('Reconnect in ' + (delay/1000) + 's (try ' + state.reconnectAttempts + ')', 'warn');
      state.reconnectTimer = setTimeout(function () {
        state.reconnectTimer = null;
        connectDeriv();
      }, delay);
    }

    function startKeepAlive() {
      stopKeepAlive();
      state.keepAliveTimer = setInterval(function () {
        if (state.wsConnected && state.ws && state.ws.readyState === WebSocket.OPEN) {
          try { state.ws.send(JSON.stringify({ ping: 1, req_id: state.reqIdCounter++ })); } catch (e) {}
        }
      }, 25000);
    }

    function stopKeepAlive() {
      if (state.keepAliveTimer) {
        clearInterval(state.keepAliveTimer);
        state.keepAliveTimer = null;
      }
    }

    function subscribeSymbol(symbol) {
      state.subscribedSymbols.add(symbol);
      if (!state.wsConnected || !state.ws || state.ws.readyState !== WebSocket.OPEN) {
        dbg('Queued sub: ' + symbol, 'warn');
        if (!state.wsConnecting && !state.wsConnected) connectDeriv();
        return;
      }
      try {
        state.ws.send(JSON.stringify({ ticks: symbol, subscribe: 1, req_id: state.reqIdCounter++ }));
        dbg('Sub sent: ' + symbol, 'ok');
      } catch (e) {
        dbg('Sub send failed: ' + symbol, 'err');
      }
    }

    function unsubscribeSymbol(symbol) {
      state.subscribedSymbols.delete(symbol);
      if (state.wsConnected && state.ws && state.ws.readyState === WebSocket.OPEN) {
        try {
          state.ws.send(JSON.stringify({ forget: symbol, req_id: state.reqIdCounter++ }));
          dbg('Unsub: ' + symbol, 'warn');
        } catch (e) {}
      }
    }

    // ================== TICK HANDLER ==================
    function handleTick(tick) {
      const symbol = tick.symbol || tick.underlying_symbol;
      const quote = parseFloat(tick.quote);
      if (isNaN(quote)) return;

      const quoteStr = quote.toString();
      const lastDigit = parseInt(quoteStr.charAt(quoteStr.length - 1), 10);
      if (isNaN(lastDigit)) return;

      if (symbol === CLASSIC_SYMBOL) {
        state.classicDigits.unshift(lastDigit);
        if (state.classicDigits.length > CLASSIC_MAX) state.classicDigits.pop();
        updateClassicUI();
      }

      if (symbol === state.deepseekSymbol) {
        state.deepseekDigits.unshift(lastDigit);
        if (state.deepseekDigits.length > DEEPSEEK_MAX) state.deepseekDigits.pop();
        state.deepseekTickCount++;

        recalcDeepseekPrediction();
        updateDCircles(lastDigit);
        updateTickStream(lastDigit, symbol);
        updateLivePredictionCard();

        state.lastDigitBySymbol[symbol] = lastDigit;
      }
    }

    // ================== DIGIT UTILITIES ==================
    function computeDigitProbabilities(digits) {
      const freq = Array(10).fill(0);
      digits.forEach(function (d) { freq[d]++; });
      const total = digits.length || 1;
      return freq.map(function (f) { return (f / total) * 100; });
    }

    function determineTickDirection(newDigit, oldDigit) {
      if (oldDigit === null || oldDigit === undefined) return 'neutral';
      if (newDigit > oldDigit) return 'up';
      if (newDigit < oldDigit) return 'down';
      return 'neutral';
    }

    // ================== CLASSIC UI ==================
    function updateClassicUI() {
      const flowDiv = document.getElementById('digitFlow');
      if (!flowDiv) return;
      flowDiv.innerHTML = state.classicDigits.map(function (d, i) {
        return '<div class="digit-cell ' + (i === 0 ? 'newest' : '') + '">' + d + '</div>';
      }).join('');

      const freq = Array(10).fill(0);
      state.classicDigits.forEach(function (d) { freq[d]++; });
      const lastDigitVal = state.classicDigits[0] || 5;
      const topDigit = freq.indexOf(Math.max.apply(null, freq));

      const predictions = [
        { name: "SketchRoyal", digit: topDigit !== -1 ? topDigit : lastDigitVal, conf: 70 + Math.floor(Math.random() * 25) },
        { name: "DollarEdge", digit: lastDigitVal, conf: 72 + Math.random() * 22 },
        { name: "LightningML", digit: (lastDigitVal + 1) % 10, conf: 75 + Math.random() * 18 },
        { name: "EnsembleAI", digit: (topDigit + lastDigitVal) % 10, conf: 78 + Math.random() * 15 }
      ];

      const predEl = document.getElementById('predictions');
      if (predEl) {
        predEl.innerHTML = predictions.map(function (p) {
          return '<div class="pred-card"><h4 style="font-size:0.85rem;">' + p.name + '</h4><div style="font-size:1.5rem;color:var(--primary-orange);">' + p.digit + '</div><div class="confidence-bar"><div class="confidence-fill" style="width:' + p.conf + '%;"></div></div><div style="font-size:0.7rem;">' + Math.round(p.conf) + '%</div></div>';
        }).join('');
      }

      if (state.classicChart) {
        state.classicChart.data.datasets[0].data = freq;
        const color = getComputedStyle(document.body).getPropertyValue('--primary-orange').trim() || '#ff8800';
        state.classicChart.data.datasets[0].backgroundColor = color;
        state.classicChart.update('none');
      }
    }

    // ================== DEEPSEEK UI ==================
    function recalcDeepseekPrediction() {
      if (state.deepseekDigits.length === 0) return;
      const freq = Array(10).fill(0);
      state.deepseekDigits.forEach(function (d) { freq[d]++; });
      const maxFreq = Math.max.apply(null, freq);
      let topDigit = freq.indexOf(maxFreq);
      if (topDigit === -1) topDigit = state.deepseekDigits[0];

      state.deepseekPrediction = topDigit;
      const freqStrength = (maxFreq / state.deepseekDigits.length) * 100;
      state.deepseekConfidence = Math.min(98, Math.round(45 + freqStrength * 0.55 + (state.deepseekDigits.length >= 15 ? 8 : 0)));
    }

    function updateTickStream(digit, symbol) {
      const prevDigit = state.lastDigitBySymbol[symbol];
      const dir = determineTickDirection(digit, prevDigit);
      const arrow = dir === 'up' ? '▲' : (dir === 'down' ? '▼' : '●');

      state._tickStreamHistory.unshift({ arrow: arrow, digit: digit, dir: dir });
      if (state._tickStreamHistory.length > 12) state._tickStreamHistory.pop();

      const tickStreamEl = document.getElementById('tickStream');
      if (!tickStreamEl) return;

      const html = state._tickStreamHistory.map(function (t) {
        const c = t.dir === 'up' ? 'var(--tick-up)' : (t.dir === 'down' ? 'var(--tick-down)' : 'var(--tick-neutral)');
        return '<span style="color:' + c + '; margin:0 2px;">' + t.arrow + t.digit + '</span>';
      }).join(' → ');

      tickStreamEl.innerHTML = '<i class="fas fa-waveform"></i> ' + html + ' <span style="color:#888;">| real-time</span>';
    }

    function updateDCircles(currentDigit) {
      if (!state.deepseekDigits.length) return;
      const probs = computeDigitProbabilities(state.deepseekDigits);
      const container = document.getElementById('circlesContainerDigits');
      if (!container) return;

      const prevDigit = state.lastDigitBySymbol[state.deepseekSymbol];
      const tickDirection = determineTickDirection(currentDigit, prevDigit);
      state.lastDigitBySymbol[state.deepseekSymbol] = currentDigit;

      let html = '';
      for (let digit = 0; digit <= 9; digit++) {
        const confidence = Math.round(probs[digit] || 0);
        const isTop = (digit === state.deepseekPrediction);
        const isLatest = (digit === currentDigit);
        let tickClass = '';
        let tickIcon = '';

        if (isLatest) {
          if (tickDirection === 'up') { tickClass = 'tick-up'; tickIcon = '▲'; }
          else if (tickDirection === 'down') { tickClass = 'tick-down'; tickIcon = '▼'; }
          else { tickClass = 'tick-neutral'; tickIcon = '●'; }
        }

        html += '<div class="d-circle ' + tickClass + ' ' + (isTop ? 'active' : '') + '">' +
          '<div class="circle-digit">' + digit + '</div>' +
          '<div class="circle-label">' + confidence + '%</div>' +
          (isLatest ? '<div class="tick-indicator">' + tickIcon + '</div>' : '') +
          '</div>';
      }
      container.innerHTML = html;

      const marketNameEl = document.getElementById('dcMarketName');
      const mkt = volatilityMarkets.find(function (m) { return m.symbol === state.deepseekSymbol; });
      if (marketNameEl) marketNameEl.textContent = mkt ? mkt.name : state.deepseekSymbol;

      const statsEl = document.getElementById('marketStatsDetail');
      if (statsEl) {
        statsEl.textContent = 'Top:' + state.deepseekPrediction + ' | ' + state.deepseekConfidence + '% | Last:' + currentDigit + ' ' + (tickDirection === 'up' ? '▲' : tickDirection === 'down' ? '▼' : '●') + ' | Ticks:' + state.deepseekTickCount;
      }

      const historyHtml = state.deepseekDigits.slice(0, 16).map(function (d, idx) {
        return '<div class="history-digit ' + (idx === 0 ? 'new-tick' : '') + '">' + d + '</div>';
      }).join('');
      const historyEl = document.getElementById('selectedDigitHistory');
      if (historyEl) historyEl.innerHTML = historyHtml;

      const freq = Array(10).fill(0);
      state.deepseekDigits.forEach(function (d) { freq[d]++; });
      if (state.deepseekChart) {
        state.deepseekChart.data.datasets[0].data = freq;
        const color = getComputedStyle(document.body).getPropertyValue('--primary-orange').trim() || '#ff8800';
        state.deepseekChart.data.datasets[0].backgroundColor = color;
        state.deepseekChart.update('none');
      }

      setTimeout(function () {
        document.querySelectorAll('.d-circle').forEach(function (c) {
          c.classList.remove('tick-up', 'tick-down', 'tick-neutral');
        });
      }, 400);
    }

    function updateLivePredictionCard() {
      const digitEl = document.getElementById('finalPredictionDigit');
      if (!digitEl) return;
      digitEl.classList.add('updating');
      setTimeout(function () { digitEl.classList.remove('updating'); }, 200);
      digitEl.textContent = state.deepseekPrediction;

      const fillEl = document.getElementById('finalConfidenceFill');
      const textEl = document.getElementById('finalConfidenceText');
      if (fillEl) fillEl.style.width = state.deepseekConfidence + '%';
      if (textEl) textEl.textContent = 'Confidence: ' + state.deepseekConfidence + '%';

      const statusEl = document.getElementById('liveUpdateStatus');
      if (statusEl) {
        statusEl.innerHTML = '<i class="fas fa-check-circle"></i> Live: Digit ' + state.deepseekPrediction + ' | ' + new Date().toLocaleTimeString();
      }
    }

    // ================== ANALYSIS ANIMATION ==================
    function startDeepAnalysis() {
      if (state.isAnalyzing) { showSnackbar("Analysis in progress..."); return; }
      if (!state.deepseekDigits.length) { showSnackbar("Waiting for live ticks..."); return; }

      state.isAnalyzing = true;
      const progressMsg = document.getElementById('progressMessage');
      const steps = ['step1', 'step2', 'step3', 'step4', 'step5'];
      steps.forEach(function (id) {
        const el = document.getElementById(id);
        el.classList.remove('active', 'completed');
        el.style.opacity = '0.5';
      });
      progressMsg.textContent = "⏳ Analyzing real-time tick patterns...";

      const stepDetails = [
        "Collecting real-time tick data from D-Circles...",
        "Analyzing tick direction patterns and volatility...",
        "DeepSeek neural network processing tick sequences...",
        "Calculating confidence based on tick momentum...",
        "Finalizing prediction output..."
      ];
      let stepIndex = 0;

      function executeStep() {
        if (stepIndex >= steps.length) {
          progressMsg.textContent = '✅ Analysis Ready - Prediction: Digit ' + state.deepseekPrediction + ' with ' + state.deepseekConfidence + '% confidence';
          showSnackbar('Analysis Ready! Prediction: ' + state.deepseekPrediction + ' (' + state.deepseekConfidence + '%)');
          triggerDollarRain();
          state.isAnalyzing = false;
          return;
        }
        const el = document.getElementById(steps[stepIndex]);
        el.classList.add('active');
        el.style.opacity = '1';
        progressMsg.textContent = '⏳ ' + stepDetails[stepIndex];
        setTimeout(function () {
          el.classList.remove('active');
          el.classList.add('completed');
          el.style.opacity = '0.8';
          stepIndex++;
          executeStep();
        }, 1200);
      }
      executeStep();
    }

