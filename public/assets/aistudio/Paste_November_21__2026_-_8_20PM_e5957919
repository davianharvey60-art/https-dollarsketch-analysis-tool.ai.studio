<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover">
  <title>DollarSketch Analysis Tool | Elite Traders + DeepSeek AI</title>
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', 'Inter', system-ui, -apple-system, sans-serif; }

    :root {
      --primary-blue: #00a6ff; --primary-orange: #ff8800; --primary-pink: #ff3b6f;
      --dark-bg: #0a0a0a; --card-bg: #0d0d0d; --dark-gray: #141414;
      --text-bright: #ffffff; --text-dim: #cccccc;
      --success: #00ff88; --danger: #ff3366; --warning: #ffcc00;
      --border-color: #2a2a2a; --gold-glow: #ffd966; --deepseek-purple: #9b4dff;
      --tick-up: #00ff88; --tick-down: #ff4466; --tick-neutral: #ffaa33;
      --body-grad-1: #05070f; --body-grad-2: #0b0e1a;
      --header-bg: rgba(8, 8, 12, 0.96); --section-bg: rgba(13, 13, 13, 0.9);
      --gradient-accent-1: var(--primary-orange); --gradient-accent-2: #cc5500;
      --logo-grad-1: var(--gold-glow); --logo-grad-2: var(--primary-orange); --logo-grad-3: var(--primary-pink);
      --price-grad-1: #ffaa33; --price-grad-2: #ff6600;
    }

    body[data-theme="orange"] { --primary-orange: #ff8800; --primary-pink: #ff3b6f; --primary-blue: #00a6ff; --gold-glow: #ffd966; --body-grad-1: #05070f; --body-grad-2: #0b0e1a; --gradient-accent-1: #ff8800; --gradient-accent-2: #cc5500; }
    body[data-theme="emerald"] { --primary-orange: #00c97b; --primary-pink: #00e5a0; --primary-blue: #00d4ff; --gold-glow: #7dffb8; --success: #00ff88; --danger: #ff4466; --tick-up: #00ff88; --tick-down: #ff4466; --tick-neutral: #7dffb8; --deepseek-purple: #00b894; --body-grad-1: #04120c; --body-grad-2: #0a1f16; --gradient-accent-1: #00c97b; --gradient-accent-2: #008a54; --price-grad-1: #00ffa3; --price-grad-2: #00a86b; --logo-grad-1: #7dffb8; --logo-grad-2: #00c97b; --logo-grad-3: #00e5a0; }
    body[data-theme="royal"] { --primary-orange: #3d7bff; --primary-pink: #8a6cff; --primary-blue: #00d4ff; --gold-glow: #b3c7ff; --success: #00e5a0; --danger: #ff4466; --tick-up: #00e5a0; --tick-down: #ff4466; --tick-neutral: #ffc857; --deepseek-purple: #a06bff; --body-grad-1: #050818; --body-grad-2: #0a1230; --gradient-accent-1: #3d7bff; --gradient-accent-2: #2550cc; --price-grad-1: #6b9dff; --price-grad-2: #2550cc; --logo-grad-1: #b3c7ff; --logo-grad-2: #3d7bff; --logo-grad-3: #8a6cff; }
    body[data-theme="crimson"] { --primary-orange: #ff4757; --primary-pink: #ff2e63; --primary-blue: #ff8fa3; --gold-glow: #ffb3c1; --success: #00e5a0; --danger: #ff2e63; --tick-up: #00e5a0; --tick-down: #ff2e63; --tick-neutral: #ffb347; --deepseek-purple: #ff6b9d; --body-grad-1: #170406; --body-grad-2: #2a0a12; --gradient-accent-1: #ff4757; --gradient-accent-2: #c0392b; --price-grad-1: #ff8fa3; --price-grad-2: #c0392b; --logo-grad-1: #ffb3c1; --logo-grad-2: #ff4757; --logo-grad-3: #ff2e63; }
    body[data-theme="purple"] { --primary-orange: #a855f7; --primary-pink: #ec4899; --primary-blue: #8b5cf6; --gold-glow: #d8b4fe; --success: #00e5a0; --danger: #ff4466; --tick-up: #00e5a0; --tick-down: #ff4466; --tick-neutral: #fbbf24; --deepseek-purple: #c084fc; --body-grad-1: #0d0416; --body-grad-2: #1a0a30; --gradient-accent-1: #a855f7; --gradient-accent-2: #7e22ce; --price-grad-1: #c084fc; --price-grad-2: #7e22ce; --logo-grad-1: #d8b4fe; --logo-grad-2: #a855f7; --logo-grad-3: #ec4899; }
    body[data-theme="cyber"] { --primary-orange: #00e5ff; --primary-pink: #00ffd5; --primary-blue: #00b4ff; --gold-glow: #a3f7ff; --success: #00ff88; --danger: #ff4466; --tick-up: #00ff88; --tick-down: #ff4466; --tick-neutral: #ffd966; --deepseek-purple: #00d4ff; --body-grad-1: #041014; --body-grad-2: #082028; --gradient-accent-1: #00e5ff; --gradient-accent-2: #0090b3; --price-grad-1: #a3f7ff; --price-grad-2: #0090b3; --logo-grad-1: #a3f7ff; --logo-grad-2: #00e5ff; --logo-grad-3: #00ffd5; }
    body[data-theme="gold"] { --primary-orange: #ffd700; --primary-pink: #ffaa00; --primary-blue: #ffea70; --gold-glow: #fff3a8; --success: #00e5a0; --danger: #ff4466; --tick-up: #00e5a0; --tick-down: #ff4466; --tick-neutral: #ffea70; --deepseek-purple: #ffbb33; --body-grad-1: #14100a; --body-grad-2: #221c08; --gradient-accent-1: #ffd700; --gradient-accent-2: #b8860b; --price-grad-1: #ffea70; --price-grad-2: #b8860b; --logo-grad-1: #fff3a8; --logo-grad-2: #ffd700; --logo-grad-3: #ffaa00; }
    body[data-theme="mono"] { --primary-orange: #e0e0e0; --primary-pink: #b0b0b0; --primary-blue: #ffffff; --gold-glow: #f5f5f5; --success: #00e5a0; --danger: #ff4466; --tick-up: #00e5a0; --tick-down: #ff4466; --tick-neutral: #c0c0c0; --deepseek-purple: #d0d0d0; --body-grad-1: #0a0a0a; --body-grad-2: #1a1a1a; --gradient-accent-1: #e0e0e0; --gradient-accent-2: #808080; --price-grad-1: #ffffff; --price-grad-2: #909090; --logo-grad-1: #ffffff; --logo-grad-2: #c0c0c0; --logo-grad-3: #909090; }

    body { background: linear-gradient(135deg, var(--body-grad-1) 0%, var(--body-grad-2) 100%); color: var(--text-bright); min-height: 100vh; overflow-x: hidden; transition: background 0.4s ease; }

    #matrixCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0.15; }
    .dollar-rain-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999; overflow: hidden; }
    .dollar { position: absolute; color: var(--gold-glow); font-size: 26px; font-weight: bold; text-shadow: 0 0 12px var(--primary-orange); animation: dollarFall linear forwards; z-index: 10000; }
    @keyframes dollarFall { 0% { transform: translateY(-10vh) rotate(0deg); opacity: 1; } 100% { transform: translateY(110vh) rotate(360deg); opacity: 0; } }

    .anti-inspect-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.98); backdrop-filter: blur(10px); z-index: 20000; display: none; justify-content: center; align-items: center; flex-direction: column; }
    .anti-inspect-overlay.active { display: flex; }
    .anti-inspect-box { background: #11161e; border: 2px solid var(--primary-orange); border-radius: 1.5rem; padding: 2rem; text-align: center; max-width: 320px; }
    .anti-inspect-box i { font-size: 2.5rem; color: var(--primary-orange); margin-bottom: 0.8rem; }

    #debugPanel {
      position: fixed; bottom: 10px; left: 10px; background: rgba(0, 0, 0, 0.9);
      border: 1px solid var(--primary-orange); border-radius: 8px; padding: 6px 10px;
      font-family: monospace; font-size: 0.65rem; color: var(--success);
      z-index: 99999; max-width: 340px; line-height: 1.4; pointer-events: none;
    }
    #debugPanel .line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #debugPanel .err { color: var(--danger); }
    #debugPanel .warn { color: var(--warning); }
    #debugPanel .ok { color: var(--success); }

    .header, .login-wrapper, #dashboard, #deepseekPage, .whatsapp-float { position: relative; z-index: 10; }
    .header { background: var(--header-bg); backdrop-filter: blur(12px); padding: 0.8rem 1rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--primary-orange); flex-wrap: wrap; gap: 0.5rem; position: sticky; top: 0; z-index: 100; transition: border-color 0.4s ease; }
    .logo { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .logo i { font-size: 1.5rem; color: var(--gold-glow); filter: drop-shadow(0 0 8px var(--primary-orange)); animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { text-shadow: 0 0 5px var(--primary-orange); } 50% { text-shadow: 0 0 20px var(--primary-orange); } }
    .logo span { font-size: 1rem; font-weight: 800; background: linear-gradient(135deg, var(--logo-grad-1), var(--logo-grad-2), var(--logo-grad-3)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .badge { background: var(--dark-gray); border: 1px solid var(--primary-orange); border-radius: 20px; padding: 0.2rem 0.5rem; font-size: 0.6rem; color: var(--primary-orange); }
    .price-tag { background: linear-gradient(95deg, var(--price-grad-1), var(--price-grad-2)); border-radius: 20px; padding: 0.2rem 0.8rem; font-size: 0.75rem; font-weight: bold; color: #0a0a0a; box-shadow: 0 0 15px var(--primary-orange); display: inline-flex; align-items: center; gap: 5px; }

    .theme-picker-wrapper { position: relative; z-index: 150; }
    .theme-toggle-btn { background: var(--dark-gray); border: 2px solid var(--primary-orange); color: var(--primary-orange); width: 42px; height: 42px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; transition: 0.3s; box-shadow: 0 0 10px rgba(0,0,0,0.5); }
    .theme-toggle-btn:hover { transform: rotate(45deg) scale(1.08); box-shadow: 0 0 18px var(--primary-orange); }
    .theme-panel { position: absolute; top: 55px; right: 0; width: 260px; background: var(--card-bg); border: 2px solid var(--primary-orange); border-radius: 1rem; padding: 0.9rem; box-shadow: 0 15px 40px rgba(0,0,0,0.85); display: none; flex-direction: column; gap: 0.6rem; animation: fadeUp 0.25s ease; }
    .theme-panel.active { display: flex; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
    .theme-panel h4 { font-size: 0.75rem; color: var(--primary-orange); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 6px; }
    .theme-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
    .theme-swatch { width: 100%; aspect-ratio: 1; border-radius: 10px; cursor: pointer; border: 2px solid transparent; position: relative; transition: 0.2s; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.65rem; font-weight: bold; text-shadow: 0 1px 3px rgba(0,0,0,0.8); }
    .theme-swatch:hover { transform: scale(1.1); border-color: white; }
    .theme-swatch.active { border-color: var(--gold-glow); box-shadow: 0 0 12px var(--gold-glow); transform: scale(1.08); }
    .theme-swatch.active::after { content: '\f00c'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; top: -6px; right: -6px; background: var(--success); color: black; width: 16px; height: 16px; border-radius: 50%; font-size: 0.5rem; display: flex; align-items: center; justify-content: center; }
    .custom-color-row { display: flex; align-items: center; gap: 0.5rem; padding-top: 0.4rem; border-top: 1px solid var(--border-color); }
    .custom-color-row label { font-size: 0.7rem; color: var(--text-dim); flex: 1; }
    .custom-color-row input[type="color"] { width: 40px; height: 32px; border: 2px solid var(--primary-orange); border-radius: 8px; background: transparent; cursor: pointer; padding: 2px; }
    .custom-color-row input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    .custom-color-row input[type="color"]::-webkit-color-swatch { border: none; border-radius: 5px; }

    .login-wrapper { max-width: 480px; width: 100%; margin: 1rem auto 2rem; background: var(--section-bg); backdrop-filter: blur(10px); border: 2px solid var(--primary-orange); border-radius: 1.5rem; padding: 1.5rem 1.2rem; transition: border-color 0.4s; }
    .login-wrapper .payment-banner { background: #1a232f; border-radius: 16px; padding: 14px 16px; margin-bottom: 18px; border-left: 4px solid var(--primary-orange); }
    .login-wrapper .payment-banner .title { font-weight: 700; font-size: 1rem; color: var(--text-bright); }
    .login-wrapper .payment-banner .title i { color: var(--primary-orange); }
    .login-wrapper .payment-banner .sub { font-size: 0.8rem; color: #b8c9e0; margin-top: 4px; line-height: 1.4; }
    .login-wrapper .whatsapp-btn { display: inline-flex; align-items: center; gap: 8px; background: #25D366; color: #0b0e14; font-weight: 700; padding: 6px 16px; border-radius: 40px; margin-top: 8px; font-size: 0.8rem; border: none; cursor: pointer; transition: 0.2s; text-decoration: none; width: fit-content; }
    .login-wrapper .whatsapp-btn:hover { transform: scale(1.02); background: #20b85f; }
    .login-wrapper .feature-list { text-align: left; margin: 12px 0 16px; display: flex; flex-direction: column; gap: 6px; }
    .login-wrapper .feature-list .item { display: flex; align-items: center; gap: 10px; font-size: 0.85rem; color: #d0def0; }
    .login-wrapper .feature-list .item i { color: var(--primary-orange); width: 18px; text-align: center; }
    .login-wrapper .big-price { font-size: 2.2rem; font-weight: 800; color: var(--primary-orange); letter-spacing: -1px; }
    .login-wrapper .price-label { color: #a0b6d0; font-size: 0.85rem; font-weight: 500; }
    .login-wrapper .lifetime { font-size: 0.75rem; color: #b0c8e0; }
    .login-wrapper .btn-primary { background: linear-gradient(95deg, var(--gradient-accent-1), var(--gradient-accent-2)); color: white; font-weight: 700; padding: 12px 20px; border-radius: 40px; border: none; width: 100%; font-size: 0.95rem; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .login-wrapper .btn-primary:hover { transform: scale(1.01); box-shadow: 0 4px 15px rgba(255, 255, 255, 0.15); }
    .login-wrapper .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .login-wrapper .btn-outline { background: transparent; border: 1.5px solid #2f3d52; color: #d0def0; font-weight: 600; padding: 10px 16px; border-radius: 40px; width: 100%; font-size: 0.9rem; cursor: pointer; transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 8px; }
    .login-wrapper .btn-outline:hover { border-color: var(--primary-orange); color: var(--primary-orange); }
    .login-wrapper .form-input { width: 100%; padding: 0.7rem 1rem; background: rgba(26, 26, 26, 0.9); border: 1px solid var(--border-color); border-radius: 0.75rem; color: white; margin: 0.5rem 0; transition: 0.2s; font-size: 1rem; }
    .login-wrapper .form-input:focus { outline: none; border-color: var(--primary-orange); }
    .login-wrapper .login-error { color: var(--danger); text-align: center; margin-top: 8px; font-size: 0.8rem; }
    .login-wrapper .social-icons { display: flex; gap: 0.8rem; justify-content: center; margin-top: 1rem; }
    .login-wrapper .social-icon { width: 38px; height: 38px; border-radius: 50%; background: var(--dark-gray); border: 1px solid var(--primary-orange); display: flex; align-items: center; justify-content: center; color: var(--primary-orange); text-decoration: none; transition: 0.2s; }
    .login-wrapper .social-icon:hover { background: #1f1f1f; color: var(--gold-glow); }
    .login-wrapper .divider { display: flex; align-items: center; gap: 12px; margin: 14px 0 12px; color: #3b4a5e; font-size: 0.7rem; font-weight: 500; }
    .login-wrapper .divider .line { flex: 1; height: 1px; background: #26303d; }

    .payment-details { background: #0f161e; border-radius: 16px; padding: 12px 14px; margin: 12px 0 8px; border: 1px solid #1f2b38; display: flex; flex-direction: column; gap: 8px; }
    .payment-details .pd-item { display: flex; align-items: center; gap: 10px; font-size: 0.78rem; color: #b8c9e0; flex-wrap: wrap; }
    .payment-details .pd-item i { color: var(--primary-orange); width: 18px; text-align: center; font-size: 0.9rem; }
    .payment-details .pd-item .pd-label { color: #6b7f96; font-weight: 600; min-width: 55px; }
    .payment-details .pd-item .pd-value { color: var(--gold-glow); font-weight: 700; word-break: break-all; font-family: monospace; font-size: 0.72rem; background: rgba(0,0,0,0.4); padding: 2px 8px; border-radius: 6px; border: 1px solid #1f2b38; }
    .payment-details .pd-item .pd-value.mpesa { color: #25D366; font-size: 0.85rem; font-weight: 800; }
    .payment-details .pd-item .copy-btn { background: #1a2634; border: 1px solid var(--primary-orange); color: var(--primary-orange); border-radius: 6px; padding: 2px 8px; font-size: 0.6rem; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
    .payment-details .pd-item .copy-btn:hover { background: var(--primary-orange); color: #0a0a0a; }

    .terms-container { display: flex; align-items: flex-start; gap: 10px; margin: 8px 0 12px; padding: 8px 10px; background: rgba(0, 0, 0, 0.3); border-radius: 10px; border: 1px solid var(--primary-orange); opacity: 0.75; }
    .terms-container input[type="checkbox"] { width: 18px; height: 18px; min-width: 18px; margin-top: 2px; accent-color: var(--primary-orange); cursor: pointer; }
    .terms-container label { font-size: 0.75rem; color: #b8c9e0; line-height: 1.5; cursor: pointer; }
    .terms-container label a { color: var(--primary-orange); text-decoration: underline; cursor: pointer; }
    .terms-container label a:hover { color: var(--gold-glow); }
    .terms-error { color: var(--danger); font-size: 0.7rem; text-align: center; margin-top: -6px; margin-bottom: 6px; display: none; }

    .terms-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(8px); z-index: 30000; justify-content: center; align-items: center; padding: 20px; }
    .terms-modal.active { display: flex; }
    .terms-modal-content { background: #11161e; border: 2px solid var(--primary-orange); border-radius: 1.5rem; padding: 2rem; max-width: 520px; width: 100%; max-height: 80vh; overflow-y: auto; position: relative; }
    .terms-modal-content h2 { color: var(--primary-orange); margin-bottom: 12px; font-size: 1.2rem; }
    .terms-modal-content .close-terms { position: absolute; top: 12px; right: 16px; background: none; border: none; color: #8fa0b8; font-size: 1.4rem; cursor: pointer; }
    .terms-modal-content .close-terms:hover { color: var(--text-bright); }
    .terms-modal-content .terms-body { color: #b8c9e0; font-size: 0.85rem; line-height: 1.7; }
    .terms-modal-content .terms-body p { margin-bottom: 10px; }
    .terms-modal-content .btn-primary { margin-top: 14px; background: linear-gradient(95deg, var(--gradient-accent-1), var(--gradient-accent-2)); color: white; border: none; padding: 12px 20px; border-radius: 40px; width: 100%; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }

    .section { background: var(--section-bg); backdrop-filter: blur(8px); border-radius: 1rem; padding: 1rem; margin: 0.8rem; border: 1px solid var(--border-color); transition: background 0.4s; }
    .section-title { font-size: 1rem; margin-bottom: 0.8rem; color: var(--primary-orange); display: flex; align-items: center; gap: 0.5rem; }

    .digit-flow { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.8rem 0; justify-content: center; }
    .digit-cell { width: 45px; height: 45px; background: rgba(0, 166, 255, 0.1); border: 2px solid var(--primary-blue); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: bold; color: var(--primary-blue); transition: all 0.3s; }
    .digit-cell.newest { background: linear-gradient(145deg, var(--gradient-accent-1), var(--gradient-accent-2)); color: white; transform: scale(1.05); border-color: var(--gold-glow); }

    .prediction-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.8rem; }
    .pred-card { background: rgba(20, 20, 20, 0.95); border-radius: 0.8rem; padding: 0.7rem; border-top: 3px solid var(--primary-pink); text-align: center; }
    .confidence-bar { height: 5px; background: #2a2a2a; border-radius: 10px; margin: 0.4rem 0; overflow: hidden; }
    .confidence-fill { height: 100%; background: linear-gradient(90deg, var(--gradient-accent-1), var(--gold-glow)); width: 0%; border-radius: 10px; transition: width 0.4s ease; }

    .status-dot { width: 10px; height: 10px; border-radius: 50%; background: #6b7280; display: inline-block; margin-left: 8px; }
    .status-dot.active { background: var(--primary-orange); box-shadow: 0 0 8px var(--primary-orange); animation: blink 1s infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

    .btn-primary-dash, .btn-secondary, .btn-deepseek, .btn-danger, .btn-success { padding: 0.6rem 1.2rem; border-radius: 2rem; font-weight: bold; cursor: pointer; transition: all 0.3s ease; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px; justify-content: center; border: none; }
    .btn-primary-dash { background: linear-gradient(95deg, var(--gradient-accent-1), var(--gradient-accent-2)); color: white; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3); }
    .btn-primary-dash:hover { transform: translateY(-2px); }
    .btn-secondary { background: rgba(20, 20, 30, 0.95); border: 1px solid var(--primary-orange); color: var(--primary-orange); }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.05); transform: translateY(-2px); }
