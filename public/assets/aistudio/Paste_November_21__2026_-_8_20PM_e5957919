    function copyToClipboard(text) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(function () {
          showSnackbar('✅ Copied: ' + text);
        }).catch(function () { fallbackCopy(text); });
      } else {
        fallbackCopy(text);
